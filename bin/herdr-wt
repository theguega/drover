#!/usr/bin/env bash
# Keep this file identical to the copy stowed at ~/.local/bin/herdr-wt.
# Open a branch as a herdr worktree workspace next to the main clone.
#   herdr-wt <name>          new branch from origin's default branch
#   herdr-wt <branch>        existing local or remote branch
#   herdr-wt <#123|123>      GitHub pull request head
#   herdr-wt prompt          ask for one of the above, then open it
#   herdr-wt [ls]            list worktrees of this repo, or of every repo in ~/Developer
#   herdr-wt rm [-f] [path]  remove a worktree (default: this one), its workspace, and its branch if merged
# Extra args are passed to herdr (default --focus). Prints herdr's JSON.
#
# Set HERDR_WORKTREE_PREFIX to put new names under a prefix (dev/cache).
# Native `herdr worktree` creates a branch from HEAD when the name exists only
# on origin, and it has no pull-request checkout. Its checkouts land in
# ~/.herdr/worktrees, not ~/Developer/<repo>.<branch>.
set -euo pipefail

for cmd in git jq herdr; do
  command -v "$cmd" >/dev/null || { echo "herdr-wt needs $cmd on PATH" >&2; exit 1; }
done

prefix="${HERDR_WORKTREE_PREFIX:-}"

# ● working  ◆ blocked  ✓ done  ○ open in herdr  · closed
list() {
  local open root path branch mark state changes ab
  open=$(herdr workspace list 2>/dev/null \
    | jq -r '.result.workspaces[] | select(.worktree) | "\(.worktree.checkout_path)\t\(.agent_status)"' || true)
  for root in "$@"; do
    git -C "$root" worktree list --porcelain | awk '
      /^worktree /{p=substr($0,10)} /^branch /{b=substr($0,19)} /^detached/{b="(detached)"}
      /^$/{if (n++) print p "\t" b; b=""}' \
    | { first=1; while IFS=$'\t' read -r path branch; do
        ((first)) && printf '%s\n' "$(basename "$root")" && first=0
        state=$(awk -F'\t' -v p="$path" '$1==p{print $2}' <<<"$open")
        case "$state" in working) mark=●;; blocked) mark=◆;; done) mark=✓;; "") mark=·;; *) mark=○;; esac
        if [[ -d "$path" ]]; then
          changes=$(git -C "$path" status --porcelain | wc -l | tr -d ' ')
          ab=$(git -C "$path" rev-list --left-right --count '@{u}...HEAD' 2>/dev/null | awk '{print "↓"$1" ↑"$2}' || true)
        else
          changes=missing ab="prune"
        fi
        printf '  %s %-34s %-10s %s\n' "$mark" "$branch" "${changes/#0/clean}" "${ab:-no upstream}"
      done; }
  done
}

rm_worktree() {
  local force=0 path root branch ws
  [[ "${1:-}" == -f ]] && force=1 && shift
  path=$(git -C "${1:-.}" rev-parse --show-toplevel)
  root=$(dirname "$(git -C "$path" rev-parse --path-format=absolute --git-common-dir)")
  [[ "$path" == "$root" ]] && { echo "this is the main clone, not a worktree" >&2; exit 1; }
  if ((!force)) && [[ -n $(git -C "$path" status --porcelain) ]]; then
    echo "uncommitted changes in $path, use rm -f" >&2; exit 1
  fi
  branch=$(git -C "$path" branch --show-current)
  ws=$(herdr workspace list | jq -r --arg p "$path" '.result.workspaces[] | select(.worktree.checkout_path == $p) | .workspace_id')

  cd "$root"
  git worktree remove --force "$path"
  if [[ -n "$branch" ]]; then
    git branch -d -q "$branch" 2>/dev/null && echo "removed $branch" || echo "removed checkout, kept $branch (not merged)"
  fi
  # last: this may be the workspace running this shell
  [[ -z "$ws" ]] || herdr workspace close "$ws" >/dev/null
}

case "${1:-}" in
  prompt)
    read -rp "worktree (name, branch or #pr): " arg || exit 0
    [[ -z "${arg:-}" ]] && exit 0
    "$0" "$arg" --focus || read -rp "failed, press enter" _
    exit
    ;;
  rm) shift; rm_worktree "$@"; exit ;;
  ls) shift ;;
esac

if [[ $# -eq 0 ]]; then
  if root=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null); then
    list "$(dirname "$root")"
  else
    list $(for d in ~/Developer/*/; do [[ -d "$d.git" ]] && echo "${d%/}"; done)
  fi
  exit
fi
arg=$1
shift
flags=("${@:---focus}")

root=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")
repo=$(basename "$root")
git -C "$root" fetch -q --prune origin

if [[ "$arg" =~ ^#?([0-9]+)$ ]]; then
  branch="pr/${BASH_REMATCH[1]}"
  git -C "$root" fetch -q origin "+pull/${BASH_REMATCH[1]}/head:$branch"
elif git -C "$root" show-ref -q --verify "refs/heads/$arg" \
  || git -C "$root" show-ref -q --verify "refs/remotes/origin/$arg"; then
  branch="$arg"
elif [[ -n "$prefix" ]]; then
  branch="$prefix/${arg#"$prefix/"}"
else
  branch="$arg"
fi

slug=${branch//\//-}
path="$(dirname "$root")/$repo.$slug"
label=$slug
[[ -n "$prefix" ]] && label=${slug#"$prefix-"}

existing=$(git -C "$root" worktree list --porcelain \
  | awk -v b="branch refs/heads/$branch" '/^worktree /{p=substr($0,10)} $0==b{print p}')

if [[ -n "$existing" ]]; then
  exec herdr worktree open --cwd "$root" --path "$existing" --label "$label" "${flags[@]}"
elif git -C "$root" show-ref -q --verify "refs/heads/$branch"; then
  git -C "$root" worktree add -q "$path" "$branch"
elif git -C "$root" show-ref -q --verify "refs/remotes/origin/$branch"; then
  git -C "$root" worktree add -q --track -b "$branch" "$path" "origin/$branch"
else
  base=$(git -C "$root" symbolic-ref -q --short refs/remotes/origin/HEAD || echo origin/main)
  exec herdr worktree create --cwd "$root" --branch "$branch" --base "$base" \
    --path "$path" --label "$label" "${flags[@]}"
fi
exec herdr worktree open --cwd "$root" --path "$path" --label "$label" "${flags[@]}"
