#!/usr/bin/env bash
# Run drover on the host in DROVER_HOST, so a client's terminal drives the service there.
#   DROVER_HOST=<host> drover ls
set -euo pipefail

host=${DROVER_HOST:-__DROVER_HOST__} # machine add writes the host here
# not the placeholder itself: machine add replaces it on this line too
[[ $host == *_HOST__ ]] && { echo "set DROVER_HOST to the ssh name of the drover host" >&2; exit 1; }
# one service per desk: it owns drover.db and the herdr watchers
[[ "${1:-}" == serve ]] && { echo "serve runs on $host, not here" >&2; exit 1; }

args=
for arg in "$@"; do args+=" $(printf '%q' "$arg")"; done
# a run on this machine speaks as itself on the host too
exec ssh -T "$host" "DROVER_RUN=$(printf '%q' "${DROVER_RUN:-}") exec drover$args"
