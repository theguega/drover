<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.theo.drover</string>
  <key>WorkingDirectory</key><string>/Users/theo/Developer/drover</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/theo/Developer/drover/target/release/drover</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/Users/theo/.local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>HOME</key><string>/Users/theo</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>/Users/theo/Developer/drover/logs/drover.log</string>
  <key>StandardErrorPath</key><string>/Users/theo/Developer/drover/logs/drover.log</string>
</dict>
</plist>
